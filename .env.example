TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional: point decisions at a local Laya sidecar instead of cloud Jev.
# See laya/README.md. When set, TYPESAFE_API_KEY is unused and may stay empty.
#TYPESAFE_ENDPOINT=http://127.0.0.1:7185/v1/systemone
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
